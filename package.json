{
  "name": "dsh-obsidian-board",
  "version": "0.2.5",
  "description": "Obsidian vault as a local RAG chat panel inside DeepSeek Harness (desktop app and Web GUI) — dedicated Obsidian conversation page with local BM25 retrieval, citations, a composer and model menu ported from the host's own chat input, and a hardened output pipeline (stop-anywhere streaming, no stale spinners, no duplicated text across provider fallbacks).",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "gen:contract": "node scripts/gen-client-contract.mjs"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./typert": "./lib/typert.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.5-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "cordis-plugin",
    "obsidian",
    "obsidian-md",
    "knowledge-base",
    "rag",
    "retrieval-augmented-generation",
    "bm25",
    "local-first",
    "notes",
    "second-brain"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2026heshao/dsh-obsidian-board.git"
  },
  "homepage": "https://github.com/2026heshao/dsh-obsidian-board#readme",
  "bugs": {
    "url": "https://github.com/2026heshao/dsh-obsidian-board/issues"
  },
  "license": "MIT"
}
